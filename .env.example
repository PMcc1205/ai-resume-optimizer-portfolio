# 可替换的大语言模型接口。当前最小代理使用兼容 Chat Completions 的 JSON 接口。
AI_API_URL=https://your-model-provider.example/v1/chat/completions
AI_API_KEY=replace-with-your-server-side-api-key
AI_MODEL=replace-with-your-model-name

# 可选配置
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=1
# Diagnosis 默认按候选数量动态设置 2048～8192；仅在需要固定上限时取消注释。
# AI_DIAGNOSIS_MAX_TOKENS=8192
# Rewrite 默认按候选数量动态设置 2048～8192；仅在需要固定上限时取消注释。
# AI_REWRITE_MAX_TOKENS=8192
# Optional: use a non-reasoning DeepSeek model for concise structured Rewrite output.
# AI_REWRITE_MODEL=deepseek-chat
