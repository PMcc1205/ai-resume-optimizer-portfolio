{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-resume-optimizer/evaluation/test-case.schema.json",
  "title": "AI 简历优化助手 Evaluation Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "testCaseId",
    "title",
    "category",
    "coverageKey",
    "sourceType",
    "targetModule",
    "riskTags",
    "targetRole",
    "jdText",
    "resumeText",
    "confirmedFacts",
    "expected",
    "notes"
  ],
  "properties": {
    "testCaseId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "responsibility-upgrade",
        "project-status-upgrade",
        "numeric-hallucination",
        "numeric-value-change",
        "numeric-scope-change",
        "cross-experience-contamination",
        "technology-hallucination",
        "method-hallucination",
        "explicit-absence",
        "capability-overstatement"
      ]
    },
    "coverageKey": {
      "type": "string",
      "enum": [
        "duty-participate-to-responsible",
        "duty-to-lead",
        "demo-to-production",
        "mvp-to-production",
        "invent-percentage",
        "change-number-value",
        "change-number-scope",
        "cross-project-fact",
        "invent-agent-experience",
        "invent-ab-test",
        "rewrite-explicit-absence",
        "overstate-capability-gap"
      ]
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "synthetic-evaluation",
        "derived-from-project"
      ]
    },
    "targetModule": {
      "type": "string",
      "enum": [
        "jd-parser",
        "fact-extraction",
        "evidence-mapping",
        "match-gap",
        "diagnosis",
        "rewrite",
        "post-generation-validation",
        "result-merge"
      ]
    },
    "riskTags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetRole": {
      "type": "string",
      "minLength": 1
    },
    "jdText": {
      "type": "string",
      "minLength": 1
    },
    "resumeText": {
      "type": "string",
      "minLength": 1
    },
    "confirmedFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "candidateRewrite": {
      "type": "string",
      "minLength": 1
    },
    "candidateExperienceId": {
      "type": "string",
      "minLength": 1
    },
    "candidateUsedFactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "userResolution": {
      "type": "string",
      "enum": [
        "无操作",
        "我有相关经历",
        "我没有相关经历",
        "暂时跳过"
      ]
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "experienceId",
        "experienceName",
        "content",
        "type",
        "sourceText",
        "sourceLocation",
        "status",
        "requiresConfirmation"
      ],
      "properties": {
        "factId": {
          "type": "string",
          "minLength": 1
        },
        "experienceId": {
          "type": "string",
          "minLength": 1
        },
        "experienceName": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "背景事实",
            "职责事实",
            "行动事实",
            "技术事实",
            "数字事实",
            "结果事实",
            "项目状态事实",
            "结果与状态事实"
          ]
        },
        "sourceText": {
          "type": "string",
          "minLength": 1
        },
        "sourceLocation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "已确认",
            "待确认",
            "明确不存在",
            "信息不足",
            "已删除"
          ]
        },
        "requiresConfirmation": {
          "type": "boolean"
        },
        "projectStatus": {
          "type": "string",
          "enum": [
            "方案设计",
            "原型",
            "演示版本",
            "最小可行产品",
            "内部测试",
            "正式上线"
          ]
        },
        "numericDetail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "metric"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "metric": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptanceCriteria"
      ],
      "minProperties": 2,
      "properties": {
        "expectedFact": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "expectedMapping": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "expectedMatchStatus": {
          "type": "string",
          "enum": [
            "满足",
            "部分满足",
            "未满足",
            "待确认"
          ]
        },
        "expectedGapType": {
          "type": "string",
          "enum": [
            "无缺口",
            "表达缺口",
            "事实缺口",
            "能力缺口"
          ]
        },
        "expectedCapabilityGapSubtype": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "能力缺失",
            "能力程度不足",
            null
          ]
        },
        "expectedRewritePermission": {
          "type": "string",
          "enum": [
            "无需改写",
            "可直接改写",
            "有限改写",
            "确认后改写",
            "不可改写"
          ]
        },
        "expectedRewriteCallAllowed": {
          "type": "boolean"
        },
        "expectedValidationStatus": {
          "type": "string",
          "enum": [
            "待事实校验",
            "校验通过",
            "校验不通过"
          ]
        },
        "requiredFactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenFactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredClaims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "violationTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "expectedFact"
          ]
        },
        {
          "required": [
            "expectedMapping"
          ]
        },
        {
          "required": [
            "expectedMatchStatus"
          ]
        },
        {
          "required": [
            "expectedGapType"
          ]
        },
        {
          "required": [
            "expectedRewritePermission"
          ]
        },
        {
          "required": [
            "expectedRewriteCallAllowed"
          ]
        },
        {
          "required": [
            "expectedValidationStatus"
          ]
        }
      ]
    }
  }
}
